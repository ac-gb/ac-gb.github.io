<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Sana Özel Bir Sürpriz...</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            color: #f8fafc;
            overflow: hidden; /* Mobilde kaymayı önler */
            overscroll-behavior: none;
            touch-action: manipulation;
        }
        
        .glass-panel {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .fade-transition {
            transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
        }

        .hide {
            opacity: 0;
            pointer-events: none;
            position: absolute;
            transform: scale(0.95);
        }

        /* Özel Slider Tasarımı */
        input[type=range] {
            -webkit-appearance: none;
            width: 100%;
            background: transparent;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 32px;
            width: 32px;
            border-radius: 50%;
            background: #f43f5e;
            cursor: pointer;
            margin-top: -10px;
            box-shadow: 0 0 15px rgba(244, 63, 94, 0.6);
            transition: transform 0.1s;
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 12px;
            cursor: pointer;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 6px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        /* Özel Checkbox (Aktörler için) */
        .actor-checkbox:checked + div {
            background-color: #f43f5e;
            border-color: #f43f5e;
            color: white;
            transform: scale(1.02);
        }
    </style>
</head>
<body class="h-screen w-screen flex flex-col items-center justify-center p-4 relative">

    <!-- GENEL UYARI MODALI -->
    <div id="custom-alert" class="fixed inset-0 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4 z-[60] fade-transition hide">
        <div class="bg-slate-800 border border-rose-500 rounded-2xl p-6 max-w-sm w-full text-center shadow-2xl">
            <p id="custom-alert-text" class="text-slate-200 mb-6 text-lg font-medium"></p>
            <button onclick="closeAlert()" class="bg-rose-500 hover:bg-rose-600 w-full py-3 rounded-lg font-semibold text-white transition-colors">Tamam</button>
        </div>
    </div>

    <!-- EKRAN 1: GİRİŞ -->
    <section id="screen-login" class="glass-panel w-full max-w-md rounded-2xl p-8 text-center fade-transition flex flex-col justify-center relative z-10">
        <div class="mb-8">
            <div class="w-16 h-16 bg-rose-500/20 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">🔒</div>
            <h1 class="text-2xl font-semibold text-white mb-2">Sistem Girişi</h1>
            <p class="text-sm text-slate-400">Lütfen kimliğinizi doğrulayın.</p>
        </div>
        
        <div class="text-left mb-4">
            <label class="block text-xs text-slate-400 mb-1 ml-1">Kullanıcı Adı</label>
            <input type="text" value="dünyanın_en_tatlı_kızı" readonly 
                   class="w-full bg-slate-900/50 border border-slate-700 rounded-lg p-3 text-rose-300 outline-none text-center font-medium">
        </div>

        <div class="text-left mb-8">
            <label class="block text-xs text-slate-400 mb-1 ml-1">Şifre (Hangi gün sevgili olduk?)</label>
            <input type="date" id="password-input" 
                   class="w-full bg-slate-900/50 border border-slate-700 rounded-lg p-3 text-white focus:border-rose-500 outline-none transition-colors [color-scheme:dark]">
        </div>

        <button onclick="checkPassword()" class="w-full bg-rose-500 hover:bg-rose-600 text-white font-semibold py-3.5 rounded-lg transition-all shadow-[0_0_15px_rgba(244,63,94,0.4)]">
            Giriş Yap
        </button>
    </section>

    <!-- EKRAN 2: QUIZ MEKANİKLERİ -->
    <section id="screen-quiz" class="glass-panel w-full max-w-md rounded-2xl p-6 sm:p-8 text-center fade-transition hide relative z-10">
        <div class="mb-6 flex justify-between text-xs text-rose-400 font-semibold uppercase tracking-wider border-b border-slate-700 pb-3">
            <span>Güvenlik Testi</span>
            <span id="question-counter">Aşama 1</span>
        </div>

        <!-- Soru 1: Kaçan Buton -->
        <div id="q1" class="quiz-step">
            <h2 class="text-xl font-semibold mb-10 text-slate-100 leading-snug">Benimle geçirdiğin son 3 ay hayatının en güzel dönemi miydi?</h2>
            <div class="flex flex-col sm:flex-row justify-center items-center gap-4 relative h-32 sm:h-20">
                <button onclick="nextQuestion(2)" class="bg-emerald-500 hover:bg-emerald-600 px-8 py-3.5 rounded-xl font-semibold text-lg w-full sm:w-auto shadow-lg shadow-emerald-500/20 z-10 transition-transform active:scale-95">Evet</button>
                <button id="btn-no" class="bg-slate-700 px-8 py-3.5 rounded-xl font-semibold text-lg w-full sm:w-auto absolute sm:relative transition-all duration-100 ease-out z-50">Hayır</button>
            </div>
        </div>

        <!-- Soru 2: Hacker Typer -->
        <div id="q2" class="quiz-step hidden">
            <h2 class="text-lg font-semibold mb-4 text-slate-100">Sence benim en çekici veya en sevdiğin özelliğim ne? (Klavyeden yaz)</h2>
            <textarea id="hacker-input" rows="4" placeholder="Buraya yazmaya başla..." 
                      class="w-full bg-slate-900 border border-slate-700 rounded-xl p-4 text-rose-300 outline-none resize-none font-medium text-lg leading-relaxed"></textarea>
            <button onclick="nextQuestion(3)" id="btn-q2" class="w-full bg-rose-500 py-3.5 rounded-xl mt-6 opacity-50 pointer-events-none transition-all font-semibold">Cevabı Onayla</button>
        </div>

        <!-- Soru 3: Kilitli Slider -->
        <div id="q3" class="quiz-step hidden">
            <h2 class="text-xl font-semibold mb-8 text-slate-100">Beni ne kadar çok seviyorsun?</h2>
            <div class="mb-10 px-2">
                <input type="range" id="love-slider" min="0" max="100" value="100">
                <div class="flex justify-between text-xs text-slate-400 mt-4 font-medium">
                    <span>%0</span>
                    <span>%100</span>
                </div>
            </div>
            <button onclick="nextQuestion(4)" class="w-full bg-rose-500 py-3.5 rounded-xl font-semibold transition-all">Onayla</button>
        </div>

        <!-- Soru 4: Aktörler Seçimi -->
        <div id="q4" class="quiz-step hidden">
            <h2 class="text-lg font-semibold mb-6 text-slate-100">Dünyadaki en yakışıklı ve karizmatik erkekler kimlerdir? (Seçiniz)</h2>
            <div class="grid grid-cols-2 gap-3 mb-8 text-sm font-medium">
                <label class="cursor-pointer relative">
                    <input type="checkbox" class="actor-check peer sr-only" value="Brad">
                    <div class="p-3 rounded-xl border border-slate-700 bg-slate-800/50 transition-all text-slate-300 flex items-center justify-center text-center h-full">Brad Pitt</div>
                </label>
                <label class="cursor-pointer relative">
                    <input type="checkbox" class="actor-check peer sr-only" value="Ryan">
                    <div class="p-3 rounded-xl border border-slate-700 bg-slate-800/50 transition-all text-slate-300 flex items-center justify-center text-center h-full">Ryan Gosling</div>
                </label>
                <label class="cursor-pointer relative">
                    <input type="checkbox" class="actor-check peer sr-only" value="Chris">
                    <div class="p-3 rounded-xl border border-slate-700 bg-slate-800/50 transition-all text-slate-300 flex items-center justify-center text-center h-full">Chris Hemsworth</div>
                </label>
                <label class="cursor-pointer relative">
                    <input type="checkbox" class="actor-check peer sr-only" value="Henry">
                    <div class="p-3 rounded-xl border border-slate-700 bg-slate-800/50 transition-all text-slate-300 flex items-center justify-center text-center h-full">Henry Cavill</div>
                </label>
            </div>
            <button onclick="checkActors()" class="w-full bg-rose-500 py-3.5 rounded-xl font-semibold">Devam Et</button>
        </div>

        <!-- Soru 4.5: Yüzleşme -->
        <div id="q4_5" class="quiz-step hidden">
            <h2 class="text-lg font-semibold mb-6 text-slate-100">Gerçekten böyle mi düşünüyorsun? Benim tırnağım bile olamazlar. Değil miiiii :(</h2>
            <div class="flex flex-col gap-3">
                <button onclick="showAlert('Bağlantı hatası, cevap iletilemedi 🚫')" class="bg-slate-700/80 hover:bg-slate-600 p-4 rounded-xl text-sm font-medium text-left transition-colors">
                    Buna cevap vermek istemiyorum.
                </button>
                <button onclick="checkActorApology()" class="bg-slate-700/80 hover:bg-slate-600 p-4 rounded-xl text-sm font-medium text-left transition-colors border-l-4 border-rose-500">
                    Şıklarda sen yoktun, mecburen seçtim.
                </button>
                <button onclick="showAlert('Öhömm, bir daha düşün istersen 😒')" class="bg-slate-700/80 hover:bg-slate-600 p-4 rounded-xl text-sm font-medium text-left transition-colors">
                    Bunların yanında sen de insan mısın be! Onları yerimmm
                </button>
            </div>
        </div>

        <!-- Soru 5: Gelecek Sözü (Sonsuz Döngü) -->
        <div id="q5" class="quiz-step hidden">
            <h2 class="text-xl font-semibold mb-10 text-slate-100 leading-snug">Gelecekte birlikte daha çok anı biriktireceğimize söz veriyor musun?</h2>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <button onclick="finishTest()" class="bg-emerald-500 hover:bg-emerald-600 py-3.5 px-6 rounded-xl font-semibold w-full sm:w-1/2 shadow-lg shadow-emerald-500/20 transition-all">Söz Veriyorum</button>
                <button onclick="show404()" class="bg-slate-700 hover:bg-slate-600 py-3.5 px-6 rounded-xl font-semibold w-full sm:w-1/2 transition-colors">Düşünmem Lazım</button>
            </div>
        </div>
    </section>

    <!-- EKRAN 3: FİNAL -->
    <section id="screen-final" class="glass-panel w-full max-w-md rounded-2xl p-8 text-center fade-transition hide relative z-10">
        <div class="text-emerald-400 text-6xl mb-4 animate-bounce">✨</div>
        <h1 class="text-3xl font-bold text-white mb-2">Başarı Skoru: %100</h1>
        <h2 class="text-xl text-rose-400 mb-6 font-semibold">Tebrikler Sevgilim!</h2>
        
        <p class="text-slate-300 leading-relaxed text-base mb-8">
            Beni bu kadar kısa sürede kusursuz bir şekilde tanıdığına emindim. Zaten aksini seçme şansın da yoktu... İyi ki hayatımdasın! ❤️
        </p>

        <button onclick="revealGift()" id="btn-reveal" class="w-full bg-rose-500 hover:bg-rose-600 text-white font-semibold py-4 rounded-xl transition-all shadow-[0_0_15px_rgba(244,63,94,0.4)]">
            🎁 Asıl Hediyeyi Gör
        </button>

        <div id="gift-card" class="mt-6 border-t border-slate-700 pt-6 hidden">
            <!-- GÖRSELI BURADAN DEĞİŞTİREBİLİRSİN -->
            <img src="https://images.unsplash.com/photo-1518199268839-497d02bc3424?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" 
                 alt="Biz" class="w-full h-48 object-cover rounded-xl mb-4 shadow-lg">
            <h3 class="font-bold text-lg text-rose-300 mb-1">Akşam Yemeği Daveti</h3>
            <p class="text-sm text-slate-300">Bu haftasonu en sevdiğin yerdeyiz. Güzelce hazırlan, seni çok seviyorum! 😘</p>
        </div>
    </section>

    <script>
        let selectedActorCount = 0;

        // --- CUSTOM ALERT ---
        function showAlert(msg) {
            document.getElementById('custom-alert-text').innerText = msg;
            const modal = document.getElementById('custom-alert');
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('hide'), 10);
        }
        function closeAlert() {
            const modal = document.getElementById('custom-alert');
            modal.classList.add('hide');
            setTimeout(() => modal.classList.add('hidden'), 500);
        }

        // --- EKRAN GEÇİŞİ ---
        function switchScreen(fromId, toId) {
            const fromEl = document.getElementById(fromId);
            const toEl = document.getElementById(toId);
            fromEl.classList.add('hide');
            setTimeout(() => {
                fromEl.classList.add('hidden');
                toEl.classList.remove('hidden');
                setTimeout(() => toEl.classList.remove('hide'), 50);
            }, 500);
        }

        function nextQuestion(step) {
            document.querySelectorAll('.quiz-step').forEach(el => el.classList.add('hidden'));
            document.getElementById('q' + step).classList.remove('hidden');
            
            // Başlığı güncelle
            let displayStep = step;
            if (step === '4_5') displayStep = 4; // 4.5 için sayacı 4'te tut
            document.getElementById('question-counter').innerText = `Aşama ${displayStep}`;
        }

        // --- GİRİŞ KONTROLÜ ---
        function checkPassword() {
            const input = document.getElementById('password-input').value;
            // DİKKAT: YIL-AY-GÜN formatında yazmalısın. Kendi tarihinize göre düzeltin.
            const correctPassword = "2023-02-14"; 

            if(input === correctPassword) {
                switchScreen('screen-login', 'screen-quiz');
            } else {
                showAlert("Hatalı tarih! İpucu: Kalbimi çaldığın gün... 💔");
            }
        }

        // --- Soru 1: Kaçan Buton (Kusursuz Mobil Uyumlu) ---
        const noBtn = document.getElementById('btn-no');
        let isFirstMove = true;

        const moveButton = (e) => {
            if(e.cancelable) e.preventDefault(); // Dokunmayı engelle
            
            if(isFirstMove) {
                noBtn.style.position = 'fixed';
                isFirstMove = false;
            }

            const btnWidth = noBtn.offsetWidth;
            const btnHeight = noBtn.offsetHeight;
            // Padding payı bırak
            const maxX = window.innerWidth - btnWidth - 40;
            const maxY = window.innerHeight - btnHeight - 40;

            let cursorX = e.clientX || (e.touches && e.touches[0].clientX) || window.innerWidth/2;
            let cursorY = e.clientY || (e.touches && e.touches[0].clientY) || window.innerHeight/2;

            let newX, newY;
            let distance = 0;

            // En az 150px uzağa fırlat
            while (distance < 150) {
                newX = 20 + Math.random() * maxX;
                newY = 20 + Math.random() * maxY;
                
                let dx = newX + (btnWidth/2) - cursorX;
                let dy = newY + (btnHeight/2) - cursorY;
                distance = Math.sqrt(dx*dx + dy*dy);
            }

            noBtn.style.left = newX + 'px';
            noBtn.style.top = newY + 'px';
            noBtn.style.bottom = 'auto';
            noBtn.style.right = 'auto';
        };

        // Hem fare hem dokunmatik için agresif dinleyiciler
        noBtn.addEventListener('mouseover', moveButton);
        noBtn.addEventListener('touchstart', moveButton, {passive: false});
        noBtn.addEventListener('pointerdown', moveButton, {passive: false});

        // --- Soru 2: Hacker Typer ---
        const hackerInput = document.getElementById('hacker-input');
        const targetText = "Çok düşünceli olman ve beni her zaman gülümsetebilmen.";
        let typedCount = 0;

        hackerInput.addEventListener('input', () => {
            typedCount++;
            if (typedCount > targetText.length) {
                document.getElementById('btn-q2').classList.remove('opacity-50', 'pointer-events-none');
                typedCount = targetText.length;
            }
            hackerInput.value = targetText.substring(0, typedCount);
        });

        // --- Soru 3: Kilitli Slider Yay Efekti ---
        const slider = document.getElementById('love-slider');
        
        const snapBack = () => {
            // CSS transition ile tatlı bir yay efekti
            slider.style.transition = 'all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
            slider.value = 100;
            setTimeout(() => { slider.style.transition = ''; }, 400);
        };

        slider.addEventListener('touchend', snapBack);
        slider.addEventListener('mouseup', snapBack);

        // --- Soru 4 & 4.5: Aktörler Yüzleşmesi ---
        function checkActors() {
            const checks = document.querySelectorAll('.actor-check:checked');
            selectedActorCount = checks.length;

            if(selectedActorCount === 0) {
                showAlert("Lütfen en azından bir kişi seç! Boş geçemezsin. 🧐");
            } else {
                nextQuestion('4_5'); // Yüzleşme ekranına atla
            }
        }

        function checkActorApology() {
            if(selectedActorCount === 1) {
                showAlert("Yiaaa ❤️ Biliyordum...");
                setTimeout(() => {
                    closeAlert();
                    nextQuestion(5);
                }, 2000);
            } else {
                showAlert("Eeee sırf ilerletebilmek için bir tane seçebilirdin. Neyse inandım diyelim... 😢");
                setTimeout(() => {
                    closeAlert();
                    nextQuestion(5);
                }, 3000);
            }
        }

        // --- Soru 5: 404 Sonsuz Döngü ---
        function show404() {
            showAlert("Error 404: Bu seçeneğe izin verilmiyor! Lütfen 'Söz Veriyorum' butonunu seçiniz. Başka bir ihtimal yok! 🚨");
        }

        // --- FİNAL EKRANI ---
        function finishTest() {
            switchScreen('screen-quiz', 'screen-final');
            setTimeout(() => fireConfetti(), 500);
        }

        function fireConfetti() {
            var duration = 3000;
            var end = Date.now() + duration;

            (function frame() {
                confetti({ particleCount: 5, angle: 60, spread: 55, origin: { x: 0 }, colors: ['#f43f5e', '#10b981', '#3b82f6'] });
                confetti({ particleCount: 5, angle: 120, spread: 55, origin: { x: 1 }, colors: ['#f43f5e', '#10b981', '#3b82f6'] });
                if (Date.now() < end) requestAnimationFrame(frame);
            }());
        }

        function revealGift() {
            const btn = document.getElementById('btn-reveal');
            const card = document.getElementById('gift-card');
            btn.classList.add('hidden');
            card.classList.remove('hidden');
            
            // Ufak bir fade animasyonu
            card.style.opacity = 0;
            setTimeout(() => {
                card.style.transition = 'opacity 1s';
                card.style.opacity = 1;
            }, 50);
        }
    </script>
</body>
</html>
